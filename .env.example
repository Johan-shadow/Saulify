# ---------------------------------------------------------------------------
# GitHub (optional, strongly recommended in production)
# A fine-grained public-repository read token raises the API quota from 60 to
# 5,000 requests/hour. Never expose this value to the browser.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# Reject repositories larger than this many megabytes. Default: 250
MAX_REPO_SIZE_MB=250

# ---------------------------------------------------------------------------
# AI reviewer (optional)
# AI_PROVIDER values: auto | opencode | openai-compatible | ollama | off
# Default is "auto", which picks the first complete configuration below.
# Without AI configuration Saulify runs deterministic static analysis only.
# ---------------------------------------------------------------------------

# AI_MODEL is the model identifier for every provider. OLLAMA_MODEL is an
# accepted alias when AI_MODEL is unset.
# AI_MODEL=

# Option 1: OpenCode Zen (https://opencode.ai/zen)
# AI_PROVIDER=opencode
# OPENCODE_API_KEY=your_server_side_key
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Option 2: any OpenAI-compatible endpoint (OpenAI, Gemini, OpenRouter, ...)
# Remote endpoints must use HTTPS; plain HTTP is allowed only for localhost.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your_server_side_key

# Option 2a: Google Gemini through its OpenAI-compatible endpoint.
# Gemini 3 models always reason; Saulify forces reasoning_effort=low and a
# larger output budget on Gemini hosts.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=your_server_side_key
# AI_MODEL=gemini-3.6-flash

# Option 3: local Ollama (no API key required)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Reasoning effort for OpenAI-compatible reasoning models: low | medium | high
# Set this if AI output is truncated by hidden reasoning tokens. Gemini hosts
# always use "low".
# AI_REASONING_EFFORT=low
